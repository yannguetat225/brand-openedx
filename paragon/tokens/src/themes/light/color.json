{
  "$type": "color",
  "color": {
    "primary": {
      "100": {
        "source": "$primary-100",
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.94"
          }
        ],
        "actions": {
          "default": "{color.action.default.primary.100}"
        },
        "$value": "{color.primary.base}",
        "$description": "Primary color of level 100."
      },
      "base": {
        "$value": "#354B1D",
        "source": "$primary",
        "$description": "Basic primary color."
      },
      "light": {
        "$value": "#DCE5CC",
        "source": "$primary-light",
        "$description": "Light primary color."
      }
    },
    "text": {
      "base": {
        "$value": "#292B26",
        "source": "$text-color",
        "$description": "Text base color."
      },
      "light": {
        "$value": "#64665E",
        "source": "$text-color-light",
        "$description": "Text light color."
      },
      "footer": {
        "$value": "#374151",
        "source": "$light-dark",
        "$description": "Footer text color."
      },
      "primary": {
        "$value": "#354B1D",
        "source": "$text-color-primary",
        "$description": "Text primary color."
      }
    },
    "brand": {
      "base": {
        "$value": "#5C7A2E",
        "source": "$brand",
        "$description": "VivaLearn primary-signal olive (DESIGN.md)."
      }
    },
    "accent": {
      "a": {
        "$value": "#C4782A",
        "source": "$accent-a",
        "$description": "VivaLearn amber, signal only (DESIGN.md)."
      },
      "b": {
        "$value": "#F2DCC3",
        "source": "$accent-b",
        "$description": "VivaLearn accent-soft (DESIGN.md)."
      }
    },
    "light": {
      "base": {
        "$value": "#EDE8DD",
        "source": "$light",
        "$description": "VivaLearn surface-muted (DESIGN.md)."
      }
    },
    "gray": {
      "700": {
        "$value": "#292B26",
        "source": "$gray-700",
        "$description": "VivaLearn ink, body text (DESIGN.md)."
      }
    },
    "bg": {
      "base": {
        "$value": "#F5F0E8",
        "source": "$body-bg",
        "$description": "VivaLearn canvas cream (DESIGN.md)."
      }
    }
  },
  "course": {
    "card": {
      "shadow": {
        "$value": "0px 0px 0px 1px rgba(0, 0, 0, 0.15), 0px 4px 6px -2px rgba(0, 0, 0, 0.15), 0px 10px 15px -3px rgba(0, 0, 0, 0.15)",
        "$type": "shadow",
        "source": "$course-card-shadow"
      }
    }
  }
}
